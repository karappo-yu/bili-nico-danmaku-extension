{
  "manifest_version": 3,
  "name": "NicoDanmaku for Bilibili",
  "version": "0.3.0",
  "description": "在 B 站播放器上直接播放 niconico 弹幕 JSON/XML。选文件 → 弹幕跟着视频走。支持输入 sm 号直接下载精选弹幕。",
  "permissions": ["storage", "unlimitedStorage"],
  "background": { "service_worker": "background.js" },
  "host_permissions": ["https://*.nicovideo.jp/*"],
  "content_scripts": [
    {
      "matches": [
        "*://*.bilibili.com/video/*",
        "*://*.bilibili.com/bangumi/play/*",
        "*://*.bilibili.com/list/*"
      ],
      "js": ["lib/bundle.js", "lib/input.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
